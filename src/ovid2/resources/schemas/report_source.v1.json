{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://ovid2.dev/schemas/report_source.v1.json",
    "title": "Ovid2 report source",
    "description": "A durable, self-describing bundle of small tabular datasets produced by one run (data-health checks, analysis aggregates, run summaries, ...). Report layouts reference datasets by name. Written by ovid2.reports.sources adapters; read by the Report Studio and its exporters.",
    "type": "object",
    "required": ["v", "source_id", "kind", "title", "generated_at", "datasets"],
    "additionalProperties": false,
    "properties": {
        "v": {"type": "integer", "const": 1},
        "source_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}-[A-Za-z0-9_.-]{1,80}$"},
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "instance_id": {"type": ["string", "null"]},
        "pipeline": {"type": ["string", "null"]},
        "batch_id": {"type": ["string", "null"]},
        "cdm": {"type": ["string", "null"]},
        "generated_at": {"type": "string"},
        "provenance": {"type": "object"},
        "recommended_templates": {"type": "array", "items": {"type": "string"}},
        "texts": {
            "type": "object",
            "description": "Named markdown snippets (e.g. an auto-generated overview).",
            "additionalProperties": {"type": "string", "maxLength": 20000}
        },
        "datasets": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
            "additionalProperties": {"$ref": "#/$defs/dataset"}
        }
    },
    "$defs": {
        "dataset": {
            "type": "object",
            "required": ["title", "columns", "rows"],
            "additionalProperties": false,
            "properties": {
                "title": {"type": "string", "maxLength": 200},
                "description": {"type": "string", "maxLength": 2000},
                "columns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/column"}},
                "rows": {"type": "array", "items": {"type": "object"}},
                "truncated": {"type": "boolean"}
            }
        },
        "column": {
            "type": "object",
            "required": ["name", "type"],
            "additionalProperties": false,
            "properties": {
                "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"},
                "type": {"enum": ["quantitative", "nominal", "ordinal", "temporal", "boolean", "text"]},
                "title": {"type": "string", "maxLength": 120},
                "sensitivity": {
                    "enum": ["aggregate", "row_values"],
                    "description": "row_values = may carry raw source values (possible PHI). Redacted for agent principals and subject to small-cell rules."
                },
                "is_count": {
                    "type": "boolean",
                    "description": "A record/patient count — subject to the layout's small-cell suppression threshold."
                }
            }
        }
    }
}
