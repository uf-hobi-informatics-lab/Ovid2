{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://ovid2.dev/schemas/transform_assignments.v1.json",
    "title": "Ovid2 transform assignments",
    "description": "Which transform chains the pipeline's `transform` stage runs on which table (pipelines/<pipeline>/transforms/assignments.yaml). The stage runs between format/deduplicate and map. Each entry is either a named chain (resolved per-pipeline → user library → shipped library) or an inline list of steps. The `*` key applies to every table, before the table-specific entries.",
    "type": "object",
    "required": ["v", "tables"],
    "additionalProperties": false,
    "properties": {
        "v": {"type": "integer", "const": 1},
        "description": {"type": "string"},
        "tables": {
            "type": "object",
            "propertyNames": {"pattern": "^(\\*|[a-z][a-z0-9_]*)$"},
            "additionalProperties": {
                "type": "array",
                "items": {"$ref": "#/$defs/entry"}
            }
        }
    },
    "$defs": {
        "entry": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "spec": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                "steps": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "required": ["op"],
                        "properties": {"op": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}}
                    }
                },
                "enabled": {"type": "boolean", "default": true}
            },
            "oneOf": [{"required": ["spec"]}, {"required": ["steps"]}]
        }
    }
}
