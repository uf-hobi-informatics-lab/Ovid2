{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://ovid2.dev/schemas/cdm_valueset.v1.json",
    "title": "Ovid2 CDM valueset (inline vocabulary)",
    "description": "Inline enum for one CDM field with a bounded value set. Ships as `resources/cdms/<cdm>/valuesets/<table>.<field>.yaml`. Registered as a VocabularyHandle via inline_items. Introduced by phase C1.",
    "type": "object",
    "required": ["v", "name", "kind", "items"],
    "additionalProperties": false,
    "properties": {
        "v":    {"type": "integer", "const": 1},
        "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]+(\\.[a-z][a-z0-9_]+){2}$",
            "description": "Dotted vocabulary name: `<cdm>.<table>.<field>` (all snake_case)."
        },
        "kind": {"type": "string", "const": "vocabulary"},
        "version": {"type": "string"},
        "description": {"type": "string"},
        "code_column":        {"type": "string", "default": "code"},
        "description_column": {"type": ["string", "null"], "default": "label"},
        "items": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": ["code"],
                "additionalProperties": false,
                "properties": {
                    "code":  {"type": "string"},
                    "label": {"type": ["string", "null"]},
                    "order": {"type": ["integer", "null"]}
                }
            }
        }
    }
}
