[Unit]
Description=Ovid2 web control panel (FastAPI + HTMX)
Documentation=https://github.com/uf-hobi-informatics-lab/Ovid2
After=network-online.target docker.service
Wants=network-online.target
# The `pyspark` engine's Test button shells out to `docker run ovid2:<tag>`,
# so the Docker daemon must be available. Failures during the test itself
# are surfaced through the panel; we don't hard-Requires docker to allow
# the panel to serve read-only pages even when Docker is offline.
Wants=docker.service

[Service]
Type=simple
User=@USER@
Environment=PYTHONUNBUFFERED=1
Environment=XDG_CONFIG_HOME=/etc
Environment=XDG_STATE_HOME=/var/lib
Environment=XDG_RUNTIME_DIR=/var/run
# Pin the compose-file mount sources so the docker containers see the host's
# real data and credential directories. Without these, DATA_DIR falls back to
# ``$XDG_DATA_HOME/ovid2/data`` (see ``ovid2.config.settings._resolve_path``)
# which on a server host is an empty directory and results in silent
# "no files found" errors at read time.
Environment=OVID2_DATA_DIR=/data
Environment=OVID2_CREDENTIALS_DIR=/ovid_credentials
# Binds loopback only (127.0.0.1:8090 by default). TLS/public exposure is
# handled by the shared host reverse proxy on 443 (it owns the
# certificates), which routes a per-app hostname to this port.
# Override the bind via /etc/ovid2/web.env if needed.
EnvironmentFile=-/etc/ovid2/web.env
ExecStart=@OVID2_BIN@ web
Restart=on-failure
RestartSec=5s
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/log/ovid2 /var/run/ovid2 /var/lib/ovid2

[Install]
WantedBy=multi-user.target
